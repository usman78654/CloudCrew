FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements-cloud.lock ./
RUN pip install -r requirements-cloud.lock && useradd --create-home --uid 10001 agent
COPY cloud ./cloud
COPY shared ./shared
COPY agents/assignment_coach/coach_agent.py ./agents/assignment_coach/coach_agent.py
COPY agents/gemini_wrapper_agent/client.py ./agents/gemini_wrapper_agent/client.py
USER agent
EXPOSE 8000
CMD ["uvicorn", "cloud.api:app", "--host", "0.0.0.0", "--port", "8000", "--log-level", "info"]
